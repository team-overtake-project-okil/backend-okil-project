DB_URL=PUTDATABASEURL
# Disable schema initialization when testing against an existing shared DB.
DB_INIT_ON_STARTUP=true
CORS_ORIGINS=["http://localhost:5173"]
REDIS_URL=redis://127.0.0.1:6379/0
CHAT_SESSION_TTL_SECONDS=1800
# Load the embedding model during startup instead of the first chat request.
CHAT_PRELOAD_AI=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SERPAPI_KEY=
SERPAPI_KEYS=
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=
TRAVELTIME_TIME_CONSTANT_SECONDS=1500
TRAVELTIME_BUS_FULL_SCORE_SECONDS=1800
TRAVELTIME_CAR_FULL_SCORE_SECONDS=1200
TRAVELTIME_MAX_SEARCH_SECONDS=14400
HERE_ROUTING_API_KEY=
