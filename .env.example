DB_URL=PUTDATABASEURL
# Disable schema initialization when testing against an existing shared DB.
DB_INIT_ON_STARTUP=true
CORS_ORIGINS=["http://localhost:5173"]
REDIS_URL=redis://127.0.0.1:6379/0
CHAT_SESSION_TTL_SECONDS=1800
# Initialize classifier scenario vectors at startup instead of the first request.
CHAT_PRELOAD_AI=false
# Workers AI REST API credentials. Backend only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
EMBEDDING_API_TIMEOUT_SECONDS=10
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SERPAPI_KEY=
SERPAPI_KEYS=
TRAVELTIME_APP_ID=
# Set false for local development without TravelTime credentials.
# Mobility is excluded from ratings; no routes are returned.
EXTERNAL_TRANSPORT_ENABLED=true
TRAVELTIME_API_KEY=
TRAVELTIME_TIME_CONSTANT_SECONDS=1500
TRAVELTIME_BUS_FULL_SCORE_SECONDS=1800
TRAVELTIME_CAR_FULL_SCORE_SECONDS=1200
TRAVELTIME_MAX_SEARCH_SECONDS=14400
DEBUG_ENABLED=false
DEBUG_USER=
DEBUG_PASSWORD=
DEBUG_REQUIRE_HTTPS=true
DEBUG_ALLOW_LOCAL_HTTP=false
